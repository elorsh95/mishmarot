# Local development against the Firebase Emulator Suite (npm run emulators)
FIREBASE_PROJECT_ID=demo-mishmarot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Any value works against the emulator. In real projects this is the Web API key
# (App Hosting also provides it automatically through FIREBASE_WEBAPP_CONFIG).
FIREBASE_API_KEY=demo-api-key
